{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BhaAnalysisRequest",
  "description": "Versioned BHA analysis request.",
  "type": "object",
  "properties": {
    "analysis_id": {
      "description": "Stable analysis identity.",
      "type": "string",
      "format": "uuid"
    },
    "components": {
      "description": "Ordered mechanical component path.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/BhaComponent"
      }
    },
    "contract_version": {
      "description": "Semantic contract version; Release 1 accepts major version 1 only.",
      "type": "string"
    },
    "hole": {
      "description": "Ordered wellbore geometry sections.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HoleSection"
      }
    },
    "operating": {
      "description": "Applied operating point.",
      "$ref": "#/$defs/OperatingPoint"
    },
    "solver": {
      "description": "Solver controls.",
      "$ref": "#/$defs/SolverSettings"
    },
    "sources": {
      "description": "Authoritative WITSML source references.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceObjectRef"
      }
    },
    "trajectory": {
      "description": "Ordered trajectory stations projected from WITSML.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrajectoryStation"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "analysis_id",
    "sources",
    "trajectory",
    "components",
    "hole",
    "operating",
    "solver"
  ],
  "$defs": {
    "BhaComponent": {
      "description": "One ordered tubular/BHA component in canonical SI.",
      "type": "object",
      "properties": {
        "bottom_md_m": {
          "description": "Component bottom measured depth in metres.",
          "type": "number",
          "format": "double"
        },
        "density_kg_m3": {
          "description": "Material density in kilograms per cubic metre.",
          "type": "number",
          "format": "double"
        },
        "id": {
          "description": "Stable component identity.",
          "type": "string",
          "format": "uuid"
        },
        "id_m": {
          "description": "Inside diameter in metres.",
          "type": "number",
          "format": "double"
        },
        "name": {
          "description": "Citation name only.",
          "type": "string"
        },
        "od_m": {
          "description": "Outside diameter in metres.",
          "type": "number",
          "format": "double"
        },
        "representation": {
          "description": "Mechanical representation.",
          "$ref": "#/$defs/ComponentRepresentation"
        },
        "top_md_m": {
          "description": "Component top measured depth in metres.",
          "type": "number",
          "format": "double"
        },
        "youngs_modulus_pa": {
          "description": "Young's modulus in pascals.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "representation",
        "top_md_m",
        "bottom_md_m",
        "od_m",
        "id_m",
        "youngs_modulus_pa",
        "density_kg_m3"
      ]
    },
    "ComponentRepresentation": {
      "description": "Mechanical representation selected for a component.",
      "oneOf": [
        {
          "description": "Six-degree rigid segment.",
          "type": "string",
          "const": "rigid"
        },
        {
          "description": "Flexible beam segment.",
          "type": "string",
          "const": "beam"
        },
        {
          "description": "Flexible segment backed by a supplied modal basis.",
          "type": "string",
          "const": "modal_flexible"
        }
      ]
    },
    "HoleSection": {
      "description": "Piecewise-constant wellbore diameter section.",
      "type": "object",
      "properties": {
        "bottom_md_m": {
          "description": "Bottom MD in metres.",
          "type": "number",
          "format": "double"
        },
        "diameter_m": {
          "description": "Hole diameter in metres.",
          "type": "number",
          "format": "double"
        },
        "top_md_m": {
          "description": "Top MD in metres.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "top_md_m",
        "bottom_md_m",
        "diameter_m"
      ]
    },
    "OperatingPoint": {
      "description": "Operating point applied to a BHA analysis.",
      "type": "object",
      "properties": {
        "fluid_density_kg_m3": {
          "description": "Fluid density in kilograms per cubic metre.",
          "type": "number",
          "format": "double"
        },
        "rpm": {
          "description": "Rotary speed in revolutions per minute, preserved for reporting.",
          "type": "number",
          "format": "double"
        },
        "wob_n": {
          "description": "Weight on bit in newtons.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "wob_n",
        "rpm",
        "fluid_density_kg_m3"
      ]
    },
    "SolverSettings": {
      "description": "Deterministic solver controls.",
      "type": "object",
      "properties": {
        "contact_penalty_n_m": {
          "description": "Contact penalty stiffness in newtons per metre.",
          "type": "number",
          "format": "double"
        },
        "max_element_length_m": {
          "description": "Maximum beam element length.",
          "type": "number",
          "format": "double"
        },
        "max_iterations": {
          "description": "Maximum nonlinear iterations.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requested_modes": {
          "description": "Number of requested modes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "residual_tolerance": {
          "description": "Residual convergence tolerance.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_element_length_m",
        "max_iterations",
        "residual_tolerance",
        "contact_penalty_n_m",
        "requested_modes"
      ]
    },
    "SourceObjectRef": {
      "description": "Immutable reference to an authoritative source object.",
      "type": "object",
      "properties": {
        "citation_name": {
          "description": "Human-readable citation only; never used as a relationship key.",
          "type": "string"
        },
        "content_hash": {
          "description": "SHA-256 of normalized source content.",
          "type": "string"
        },
        "object_type": {
          "description": "Supported object type.",
          "$ref": "#/$defs/WitsmlObjectType"
        },
        "source_system": {
          "description": "Source system name/version.",
          "type": "string"
        },
        "uri": {
          "description": "Optional absolute Energistics URI.",
          "type": [
            "string",
            "null"
          ]
        },
        "uuid": {
          "description": "WITSML object UUID.",
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "uuid",
        "object_type",
        "content_hash",
        "citation_name",
        "source_system"
      ]
    },
    "TrajectoryStation": {
      "description": "WITSML-aligned trajectory station used to orient gravity relative to the BHA.",
      "type": "object",
      "properties": {
        "azimuth_rad": {
          "description": "Azimuth in radians.",
          "type": "number",
          "format": "double"
        },
        "inclination_rad": {
          "description": "Inclination from vertical in radians.",
          "type": "number",
          "format": "double"
        },
        "md_m": {
          "description": "Measured depth in metres.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "md_m",
        "inclination_rad",
        "azimuth_rad"
      ]
    },
    "WitsmlObjectType": {
      "description": "WITSML object types accepted by BHA Release 1.",
      "oneOf": [
        {
          "description": "Well.",
          "type": "string",
          "const": "well"
        },
        {
          "description": "Wellbore.",
          "type": "string",
          "const": "wellbore"
        },
        {
          "description": "Directional trajectory.",
          "type": "string",
          "const": "trajectory"
        },
        {
          "description": "Hole geometry.",
          "type": "string",
          "const": "wellboreGeometry"
        },
        {
          "description": "Tubular/BHA configuration.",
          "type": "string",
          "const": "tubular"
        },
        {
          "description": "BHA run context.",
          "type": "string",
          "const": "bhaRun"
        },
        {
          "description": "Log container.",
          "type": "string",
          "const": "log"
        },
        {
          "description": "Channel set.",
          "type": "string",
          "const": "channelSet"
        },
        {
          "description": "Channel.",
          "type": "string",
          "const": "channel"
        }
      ]
    }
  }
}
