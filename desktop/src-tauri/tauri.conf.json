{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WellForge",
  "version": "0.1.0",
  "identifier": "com.wellforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WellForge",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/app.ico"],
    "targets": "all"
  }
}
